---
import { type Locale, type UITranslations } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: UITranslations;
}

const { locale, t } = Astro.props;
const siteOrigin = 'https://mutevideo.github.io';
const pageUrl = `${siteOrigin}${getLocalizedPath(locale)}`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#webapp`,
      name: 'MuteVideo Online — Remove Audio from Video',
      url: pageUrl,
      description: t.meta.description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All (iOS, Android, Windows, macOS, Linux)',
      inLanguage: locale,
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
      },
      featureList: t.features.items.map((f) => f.title),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t.breadcrumbs.home,
          item: pageUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t.breadcrumbs.tools,
          item: `${pageUrl}#tools-comparison`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: t.breadcrumbs.current,
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'HowTo',
      name: t.howTo.title,
      description: t.howTo.subtitle,
      step: t.howTo.steps.map((step, index) => ({
        '@type': 'HowToStep',
        position: index + 1,
        name: step.title,
        text: step.desc,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
